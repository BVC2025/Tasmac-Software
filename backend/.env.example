RVM_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/tasmac_rvm
RVM_QR_SIGNING_SECRET=tasmac-test-secret-change-me
RVM_JWT_SECRET=change-me-to-a-long-random-string
RVM_PAYOUT_WEBHOOK_SECRET=change-me
RVM_PAYOUT_PROVIDER=mock
RVM_SMS_PROVIDER=mock
RVM_TEST_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/tasmac_rvm_test

# Accept real bottle QRs registered in Admin -> QR registry (demo / pilot). false once TASMAC verification is live.
RVM_QR_REGISTRY_ENABLED=true

# SMS: mock (default) or android_gateway = a test phone with the "SMS Gateway for Android" app
# (Local Server mode) sends real SMS from its SIM. Internal testing only; production needs DLT.
RVM_SMS_PROVIDER=mock
RVM_SMS_GATEWAY_URL=http://192.168.1.3:8080
RVM_SMS_GATEWAY_USERNAME=
RVM_SMS_GATEWAY_PASSWORD=
